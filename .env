VITE_API_URL='https://beta-api.brownfi.io'

# V3 Official (version 4) Bera indexer. Override removed so it falls through to
# ${VITE_API_URL}/indexer/v3 = https://beta-api.brownfi.io/indexer/v3 (BE serves
# the merged v3-final data + uniV2Price) instead of the Goldsky subgraph.
# VITE_INDEXER_V3_URL='https://api.goldsky.com/api/public/project_cmnr78dg7vvfo01tb91e6426e/subgraphs/bf-v3-berachain/0.0.2/gn'

# Goldsky subgraph for the V3 PILOT (version 3) factory 0x83A329E9 — the 0.0.1
# subgraph. BETA/DEV ONLY: Pilot is hidden on mainnet, so this is intentionally
# NOT set on the release/bera .env. Needed because the BE merged v3-final into
# /indexer/v3, so without this Pilot would show the Official pools, not its own.
VITE_INDEXER_V3_PILOT_URL='https://api.goldsky.com/api/public/project_cmnr78dg7vvfo01tb91e6426e/subgraphs/bf-v3-berachain/0.0.1/gn'

VITE_KYBERSWAP_ZAP_API_URL='https://zap-api.kyberswap.com'
# Route the Kyber Aggregator API through our same-origin proxy (functions/kyber-agg
# on CF Pages, vercel.json rewrite on Vercel, vite proxy in dev). Kyber turned on
# a Cloudflare 403/bot-wall on aggregator-api.kyberswap.com (2026-07-16) that
# breaks direct browser calls (CORS preflight fails). Set to the direct URL to
# bypass the proxy once Kyber allowlists us.
VITE_KYBERSWAP_AGG_API_URL='/kyber-agg'

VITE_WALLETCONNECT_PROJECT_ID='3441811a50334d46eef9f2435cadee36'
#mainnet beta testnet
VITE_ENVIRONMENT='beta'
# Navbar badge: no VITE_ENV_LABEL override on beta → falls back to appEnv ('beta').
# (develop sets VITE_ENV_LABEL='dev'; this line was pulled in by the merge and removed.)

# Kyber aggregator affiliate fee — 2 bps (0.02%) skim from input side,
# forwarded to BrownFi treasury via Kyber's router on every swap.
VITE_KYBER_FEE_RECEIVER='0x6369D6BE96B2B36FC30fB033703B3829a938b975'
VITE_KYBER_FEE_BPS='2'
VITE_KYBER_FEE_SIDE='currency_in'
