# Production API. As of 2026-06-18 api.brownfi.io serves V3 for Bera + HyperEVM
# (incl. uniV2Price), verified 1:1 with beta-api (Manh promoted to prod). V3 is
# enabled for this host via isV3Enabled in connectors/index.ts. No Goldsky
# override needed (the BE indexer serves the merged v3-final data per chain).
VITE_API_URL='https://api.brownfi.io'

VITE_KYBERSWAP_ZAP_API_URL='https://zap-api.kyberswap.com'
# Route the Kyber Aggregator API through our same-origin proxy (functions/kyber-agg
# on CF Pages, vercel.json rewrite on Vercel, vite proxy in dev). Kyber turned on a
# Cloudflare 403/bot-wall on aggregator-api.kyberswap.com (2026-07-16) that breaks
# direct browser calls (CORS preflight fails). Set to the direct URL to bypass the
# proxy once Kyber allowlists us.
VITE_KYBERSWAP_AGG_API_URL='/kyber-agg'

VITE_WALLETCONNECT_PROJECT_ID='3441811a50334d46eef9f2435cadee36'
#mainnet beta testnet
VITE_ENVIRONMENT='mainnet'
# Navbar badge: no VITE_ENV_LABEL override on beta → falls back to appEnv ('beta').
# (develop sets VITE_ENV_LABEL='dev'; this line was pulled in by the merge and removed.)

# Kyber aggregator affiliate fee — 2 bps (0.02%) skim from input side,
# forwarded to BrownFi treasury via Kyber's router on every swap.
VITE_KYBER_FEE_RECEIVER='0x6369D6BE96B2B36FC30fB033703B3829a938b975'
VITE_KYBER_FEE_BPS='2'
VITE_KYBER_FEE_SIDE='currency_in'
