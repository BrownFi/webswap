{
  "outputDirectory": "build",
  "rewrites": [
    { "source": "/prjx/:path*", "destination": "https://api.prjx.com/:path*" },
    { "source": "/kyber-agg/:path*", "destination": "https://aggregator-api.kyberswap.com/:path*" },
    { "source": "/uniswap/:path*", "destination": "/api/uniswap" },
    { "source": "/uniswap-data/:path*", "destination": "/api/uniswap-data" },
    { "source": "/uniswap-liquidity/:path*", "destination": "/api/uniswap-liquidity" },
    { "source": "/(.*)", "destination": "/" }
  ]
}
