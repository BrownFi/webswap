# Required
VITE_API_URL='https://api.brownfi.io'

# Optional: dedicated V3 indexer URL (overrides VITE_API_URL/indexer/v3 when
# set). Use when the V3 indexer for a fresh factory isn't folded into the
# main API yet — set to the Goldsky/hosted subgraph URL temporarily.
# VITE_INDEXER_V3_URL='https://api.goldsky.com/api/public/...'

# Optional
VITE_KYBERSWAP_ZAP_API_URL='https://zap-api.kyberswap.com'
VITE_WALLETCONNECT_PROJECT_ID='your-walletconnect-project-id'
VITE_ENVIRONMENT='mainnet'

# Kyber aggregator affiliate fee — set all three together to engage.
# Leave any unset = no fee, no behavior change.
# VITE_KYBER_FEE_RECEIVER='0x0000000000000000000000000000000000000000'  # treasury wallet
# VITE_KYBER_FEE_BPS='2'                                                # basis points (2 = 0.02%)
# VITE_KYBER_FEE_SIDE='currency_out'                                    # 'currency_in' or 'currency_out'

# --- CLMM (Hemi Algebra) — all optional; empty falls back to on-chain reads ---
# Subgraph URLs for the CLMM product on Hemi (pool/position lists, analytics).
VITE_HEMI_INFO_SUBGRAPH=
VITE_HEMI_BLOCKS_SUBGRAPH=
VITE_HEMI_FARMING_SUBGRAPH=
VITE_HEMI_LIMIT_ORDERS_SUBGRAPH=
# The Graph API key for CLMM's placeholder Uniswap analytics (analytics module off).
VITE_GRAPH_API_KEY=
